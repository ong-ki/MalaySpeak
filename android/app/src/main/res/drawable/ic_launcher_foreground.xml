<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      MalaySpeak glassmorphism + circular progress ring mark.
      All geometry sits inside the central 66dp adaptive safe zone
      (outer radius 30.4dp from center 54,54; safe circle radius 33dp).
    -->

    <!-- Subtle translucent circular progress ring track -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 54,82 A28,28 0 1,1 54,26 Z"
        android:strokeColor="#26FFFFFF"
        android:strokeWidth="4.6" />

    <!-- Bold 75% (270 deg) round-cap progress arc in high-contrast MintGlow -->
    <path
        android:pathData="M26,54 A28,28 0 1,1 54,82"
        android:strokeColor="@color/ic_launcher_ring_accent"
        android:strokeLineCap="round"
        android:strokeWidth="4.8" />

    <!-- Frosted translucent white glass speech bubble (~85-95% alpha) -->
    <path android:pathData="M48,38 L60,38 A12.5,12.5 0 0,1 72.5,50.5 L72.5,52.5 A12.5,12.5 0 0,1 60,65 L49.5,65 C45.8,65.0 42.4,67.8 39.0,69.2 C37.34,69.89 35.9,68.53 36.4,66.8 C37.13,64.3 37.77,60.14 36.67,57.78 A12.5,12.5 0 0,1 35.5,52.5 L35.5,50.5 A12.5,12.5 0 0,1 48,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="72.5"
                android:endY="70"
                android:startX="35.5"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#F2FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#E6FFFFFF"
                    android:offset="0.55" />
                <item
                    android:color="#D9FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle lighter-to-transparent specular glass edge -->
    <path
        android:pathData="M48,38 L60,38 A12.5,12.5 0 0,1 72.5,50.5 L72.5,52.5 A12.5,12.5 0 0,1 60,65 L49.5,65 C45.8,65.0 42.4,67.8 39.0,69.2 C37.34,69.89 35.9,68.53 36.4,66.8 C37.13,64.3 37.77,60.14 36.67,57.78 A12.5,12.5 0 0,1 35.5,52.5 L35.5,50.5 A12.5,12.5 0 0,1 48,38 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="1.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="72.5"
                android:endY="70"
                android:startX="35.5"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#80FFFFFF"
                    android:offset="0.45" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
